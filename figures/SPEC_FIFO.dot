// First-faulted-first-repaired requirement (state-changing transitions only).
// Edge labels are TCT event numbers. Self-loops on unrelated events are omitted;
// the captions state that they are present in the model.
digraph SpecFifo {
  rankdir=LR;
  graph [fontname="Arial", bgcolor="white", nodesep=0.28, ranksep=0.65, pad=0.08];
  node [shape=circle, fontname="Arial", fontsize=11, width=0.52, fixedsize=true,
        color="#294861", penwidth=1.1];
  edge [fontname="Arial", fontsize=10, color="#496B83", arrowsize=0.62];
  start [shape=point, width=0.07, color="#294861"];
  start -> 0 [color="#294861"];
  0 [shape=doublecircle];
  1 [shape=doublecircle];
  2 [shape=doublecircle];
  3 [shape=doublecircle];
  4 [shape=doublecircle];
  { rank=same; 1; 2; }
  { rank=same; 3; 4; }
  0 -> 1 [label="4, 24"];
  0 -> 2 [label="16, 26"];
  1 -> 0 [label="6"];
  1 -> 3 [label="16, 26"];
  2 -> 0 [label="18"];
  2 -> 4 [label="4, 24"];
  3 -> 2 [label="6"];
  4 -> 1 [label="18"];
}
